{
  "name": "mi-dashboard-financiero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 -p 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "ingest:estados": "cd ingestor && python ingest_estados_cuenta.py",
    "ingest:estados:dry": "cd ingestor && python ingest_estados_cuenta.py --dry-run",
    "gcal:probe": "node scripts/gcal-probe.mjs",
    "hr:backfill-expedientes": "node --experimental-strip-types scripts/hr-backfill-expediente-links.mjs",
    "hr:reconcile-dupes": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/hr-reconcile-duplicates.mjs",
    "hr:reconcile-expedientes": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/hr-reconcile-expedientes.mjs",
    "hr:import-horarios": "node scripts/hr-import-horarios-2026.mjs",
    "hr:sync-sueldo": "node --experimental-strip-types scripts/hr-sync-sueldo-diario.mjs",
    "hr:reimport-sueldo": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/hr-reimport-sueldo-diario.mjs",
    "hr:pull-docs": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/hr-pull-expediente-docs.mjs",
    "hr:fill-identity": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/hr-fill-identity.mjs",
    "hr:fill-contrato": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/hr-fill-from-contrato-xlsx.mjs",
    "hr:repair-docs": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/hr-repair-doc-slots.mjs",
    "finanzas:cristaleria": "node --import ./scripts/register-ts-alias.mjs --experimental-strip-types scripts/cristaleria-conciliacion.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tremor/react": "^3.18.7",
    "googleapis": "^173.0.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
