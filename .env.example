# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Acceso bootstrap (primer admin; se crea en Supabase al primer login si la tabla existe)
DASHBOARD_USER=sergio
DASHBOARD_PASSWORD=cambia-esta-clave
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Después de crear la tabla (supabase/dashboard_users.sql), el admin se gestiona en /admin

# Eventos · rutas locales Drive (opcionales; default I:\Mi unidad\Eventos)
# EVENTOS_PATH=I:\Mi unidad\Eventos
# EVENTOS_CLIENTS_EXCEL=I:\Mi unidad\Eventos\lista de clientes Carranza 50.xlsx
# EVENTOS_OS_PATH=I:\Mi unidad\Eventos\Ordenes de servicio

# Eventos · Google Calendar hold (service account JWT + domain-wide delegation)
# Un calendario compartido (nombre típico: «Eventos»); hold 72 h hábiles (sin hold si faltan <15 días).
# GCAL_CALENDAR_ID = ID real (p. ej. …@group.calendar.google.com), no el nombre «Eventos».
# GCAL_PRIVATE_KEY: solo el PEM (-----BEGIN…-----END…), con \n escapados en una sola línea.
# No pegues fragmentos JSON (evita prefijos tipo `": "` alrededor del PEM).
#
# Workspace: ACL write al SA suele estar bloqueado → usa impersonación (DWD):
# 1) GCP → IAM → Service Accounts → SA → Advanced → Enable Google Workspace domain-wide delegation
#    (anota el Client ID numérico, no el email).
# 2) admin.google.com → Seguridad → Control de acceso y de datos → Delegación a nivel de dominio
#    → Añadir Client ID + scope: https://www.googleapis.com/auth/calendar → Autorizar
# 3) GCAL_IMPERSONATE_USER = usuario Workspace con acceso al calendario (p. ej. dueño).
GCAL_CALENDAR_ID=
GCAL_CLIENT_EMAIL=
GCAL_PRIVATE_KEY=
GCAL_IMPERSONATE_USER=

# RR.HH. · Nóminas locales (fuente primaria en /rrhh → Nómina)
# Carpeta con NOMINA C50 2026…2022.xlsx (default: %USERPROFILE%\Downloads)
HR_NOMINA_LOCAL_DIR=C:\Users\magno\Downloads

# Carpeta con HORARIOS C50 2026.xlsx (default: misma que nómina / Downloads)
# HR_HORARIOS_LOCAL_DIR=C:\Users\magno\Downloads
# Opcional · Drive (legacy / BASE DATOS / listado):
# HR_NOMINA_DRIVE_FOLDER_ID=1qIZq7O2lcvs5zxG6p5jjzh4wRMXoFK3J
# HR_EXPEDIENTES_DRIVE_FOLDER_ID=
# HR_DOCS_VIGENTE_DRIVE_FOLDER_ID=
# Auth Drive (si se usa): GOOGLE_OAUTH_* o GCAL_* + HR_DRIVE_IMPERSONATE_USER
#
# File Stream local (I:\Mi unidad\RH). En Vercel está OFF automáticamente.
# Solo activa en el PC de sync/admin si quieres Abrir/explorar rutas locales:
# HR_ALLOW_LOCAL_FS=1
# HR_ALLOW_LOCAL_FS=0


