# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Acceso bootstrap (primer admin; se crea en Supabase al primer login si la tabla existe)
DASHBOARD_USER=sergio
DASHBOARD_PASSWORD=cambia-esta-clave
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# URL pública canónica (producción). Enlaces de cotización /c/{token} y «Copiar enlace».
# NEXT_PUBLIC_SITE_URL=https://admin.carranza50.com.mx

# Reservaciones mesa · /reservar → WhatsApp Business (dígitos E.164 sin +)
# Default: (442) 212 3031 → 524422123031. SQL: supabase/restaurant_reservations.sql
# NEXT_PUBLIC_RESERVAS_WHATSAPP=524422123031
# NEXT_PUBLIC_RESERVAS_BRAND=Carranza 50

# Eventos · transferencia BBVA (se muestran al cliente si acepta con ese método)
# EVENTOS_BBVA_BENEFICIARY=Carranza 50
# EVENTOS_BBVA_CLABE=
# EVENTOS_BBVA_ACCOUNT=
# EVENTOS_BBVA_REFERENCE_HINT=Usa el folio de cotización como referencia

# Después de crear la tabla (supabase/dashboard_users.sql), el admin se gestiona en /admin

# ─── Admin · Sincronizaciones (botón Actualizar / Sincronizar ahora) ───
# PAT con scope actions:write (classic) o fine-grained → Actions: Read and write
# sobre el repo magnon82/Dashboard-C50. En Vercel → Settings → Environment Variables.
# Sin esto, Actualizar solo refresca timestamps; usa Actions → Run workflow.
# GH_WORKFLOW_DISPATCH_TOKEN=
# (alternativa local) GITHUB_TOKEN=

# Eventos · rutas locales Drive (opcionales; default I:\Mi unidad\Eventos)
# EVENTOS_PATH=I:\Mi unidad\Eventos
# EVENTOS_CLIENTS_EXCEL=I:\Mi unidad\Eventos\lista de clientes Carranza 50.xlsx
# EVENTOS_OS_PATH=I:\Mi unidad\Eventos\Ordenes de servicio
# Producción: PDFs viven en Supabase Storage (bucket eventos-os-docs) tras sync.
# Drive/File Stream solo ingest. SQL: supabase/eventos_os_documents.sql
# EVENTOS_OS_DRIVE_FOLDER_ID=   # ID carpeta «Ordenes de servicio» (Drive → URL …/folders/ID)
# Comparte esa carpeta con el SA / OAuth (drive.readonly). Actualizar en UI corre sync_pdfs.

# Eventos · Google Calendar hold (service account JWT + domain-wide delegation)
# Un calendario compartido (nombre típico: «Eventos»); hold 72 h hábiles (sin hold si faltan <15 días).
# GCAL_CALENDAR_ID = ID real (p. ej. …@group.calendar.google.com), no el nombre «Eventos».
# GCAL_PRIVATE_KEY: solo el PEM (-----BEGIN…-----END…), con \n escapados en una sola línea.
# No pegues fragmentos JSON (evita prefijos tipo `": "` alrededor del PEM).
#
# Workspace: ACL write al SA suele estar bloqueado → usa impersonación (DWD):
# 1) GCP → IAM → Service Accounts → SA → Advanced → Enable Google Workspace domain-wide delegation
#    (anota el Client ID numérico, no el email).
# 2) admin.google.com → Seguridad → Control de acceso y de datos → Delegación a nivel de dominio
#    → Añadir Client ID + scope: https://www.googleapis.com/auth/calendar → Autorizar
# 3) GCAL_IMPERSONATE_USER = usuario Workspace con acceso al calendario (p. ej. dueño).
GCAL_CALENDAR_ID=
GCAL_CLIENT_EMAIL=
GCAL_PRIVATE_KEY=
GCAL_IMPERSONATE_USER=

# RR.HH. · Nóminas locales (fuente primaria en /rrhh → Nómina en PC admin)
# Carpeta con NOMINA C50 2026…2022.xlsx (default: %USERPROFILE%\Downloads)
HR_NOMINA_LOCAL_DIR=C:\Users\magno\Downloads

# Carpeta con HORARIOS C50 2026.xlsx (default: misma que nómina / Downloads)
# HR_HORARIOS_LOCAL_DIR=C:\Users\magno\Downloads

# ─── Producción (Vercel): Drive API → Supabase/Storage (sin I:\ File Stream) ───
# Auth (elige uno):
#   A) OAuth (mismo token que ingestor): GOOGLE_OAUTH_TOKEN_JSON (+ opcional GOOGLE_OAUTH_CLIENT_JSON)
#   B) Service account: reutiliza GCAL_CLIENT_EMAIL + GCAL_PRIVATE_KEY
#      + HR_DRIVE_IMPERSONATE_USER o GCAL_IMPERSONATE_USER (DWD) si hace falta
# Scopes: drive.readonly + spreadsheets.readonly
# Comparte las carpetas RH con el email del SA (o usa impersonación).
#
# GOOGLE_OAUTH_TOKEN_JSON=
# GOOGLE_OAUTH_CLIENT_JSON=
# HR_DRIVE_IMPERSONATE_USER=

# Folder IDs (Drive → compartir con SA / OAuth):
# HR_NOMINA_DRIVE_FOLDER_ID=1qIZq7O2lcvs5zxG6p5jjzh4wRMXoFK3J
# HR_EXPEDIENTES_DRIVE_FOLDER_ID=   # «Expedientes personal C50» (Altas/Bajas)
# HR_DOCS_VIGENTE_DRIVE_FOLDER_ID=  # «Documentación vigente» (biblioteca)
# HR_PERFILES_DRIVE_FOLDER_ID=     # opcional · Perfiles por posición
# HR_EXAMENES_DRIVE_FOLDER_ID=     # opcional · Exámenes piso
#
# Soft-pull en perfil / alertas / POST /api/hr/employees/pull-docs usa Drive→Storage
# (bucket hr-employee-docs) cuando no hay File Stream.
#
# File Stream local (I:\Mi unidad\RH). En Vercel está OFF automáticamente.
# Solo activa en el PC de sync/admin si quieres Abrir/explorar rutas locales:
# HR_ALLOW_LOCAL_FS=1
# HR_ALLOW_LOCAL_FS=0
# Overrides opcionales de raíz local (solo PC admin; ignorados en Vercel):
# DRIVE_MI_UNIDAD_PATH=I:\Mi unidad
# HR_PATH=I:\Mi unidad\RH

# ─── Finanzas · PDFs locales (solo PC admin / File Stream; Vercel = índice sin abrir) ───
# FACTURAS_PATH=I:\Mi unidad\FACTURAS CFDI
# COMPROBANTES_PATH=I:\Mi unidad\COMPROBANTES BANCARIOS
# BANCOS_ESTADOS_PATH=I:\Mi unidad\Administración\Bancos
# Paridad nube (pendiente): subir adjuntos a Supabase Storage en ingest + signed URLs;
#   o folder IDs Drive + Drive API (mismo patrón que HR_DOCS_VIGENTE_DRIVE_FOLDER_ID).
# FACTURAS_DRIVE_FOLDER_ID=
# COMPROBANTES_DRIVE_FOLDER_ID=
# BANCOS_ESTADOS_DRIVE_FOLDER_ID=

